{
  "rewrites": [
    {
      "source": "/item/",
      "has": [{ "type": "query", "key": "product" }],
      "destination": "/api/item"
    },
    {
      "source": "/brand/",
      "has": [{ "type": "query", "key": "brand" }],
      "destination": "/api/brand"
    },
    {
      "source": "/product/",
      "has": [{ "type": "query", "key": "filter" }],
      "destination": "/api/filter"
    },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/llms.txt", "destination": "/api/llms" }
  ]
}